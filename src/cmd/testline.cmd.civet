# testline.cmd.civet

import {allLinesIn} from 'llfs'
import {toBool} from 'datatypes'
import {undef, LOG} from 'base-utils'
import {MAP} from 'mapper'

# ---------------------------------------------------------------------------

[stub, testNum] := Deno.args
LOG "stub = #{stub}"
LOG "testNum = #{testNum}"
path := "src/test/#{stub}.lib.test.civet"
LOG "path = #{path}"

type TInfo = [
	totLines: number
	totTests: number
	foundLine: number
	]
acc0: TInfo := [0, 0, 0]

isTest := (line: string): boolean =>
	return toBool line.match /\b(?:equal|truthy|falsy|fails|succeeds)\b/

[nLines, nTests, foundLine] := await MAP allLinesIn(path), acc0, (line, acc, lineNum) ->
	[nLines, nTests, foundLine] := acc
	return [
		nLines + 1
		isTest(line) ? nTests + 1 : nTests
		(nTests == Number(testNum)) ? lineNum : foundLine
		]

LOG "nLines = #{nLines}"
LOG "nTests = #{nTests}"
LOG "foundLine = #{foundLine}"

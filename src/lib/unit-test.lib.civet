# unit-test.lib.civet

import {doesNotThrow} from "node:assert"
import {assert, assertEquals, assertThrows} from '@std/assert'

import {unify} from 'unify'
import {
	undef, sleep, defined, notdefined,
	} from 'base-utils'
import {justThrow, croak, getMyOutsideCaller} from 'croak'
import {TIterator, TAsyncIterator, TVoidFunc, hash} from 'datatypes'

let nextNum = 1

# ---------------------------------------------------------------------------

getTestName := (): string =>

	n := nextNum
	nextNum += 1
	frame := getMyOutsideCaller()
	return "#{n}. " + (defined(frame) ? "line #{frame.line}" : "line ?")

# ---------------------------------------------------------------------------

export equal := (
		value: unknown,
		expected: unknown
		name?: string
		): void =>

	Deno.test name || getTestName(), () => assertEquals(value, expected)
	return

# ---------------------------------------------------------------------------

export truthy := (
		value: unknown
		name?: string
		): void =>

	Deno.test name || getTestName(), () => assert value
	return

# ---------------------------------------------------------------------------

export falsy := (
		value: unknown
		name?: string
		): void =>

	Deno.test name || getTestName(), () => assert (not value)
	return

# ---------------------------------------------------------------------------

export succeeds := (
	func: TVoidFunc
	name?: string
	): void =>

	Deno.test name || getTestName(), (): void =>
		await func()
	return

# ---------------------------------------------------------------------------

export fails := (
	func: TVoidFunc
	name?: string
	): void =>

	Deno.test name || getTestName(), (): void =>
		justThrow true
		try
			func()
			croak "in fails() but function succeeded"
		catch err
		finally
			justThrow false
	return

# ---------------------------------------------------------------------------
# ASYNC

export generates := <TOut>(
		value: TIterator<TOut>
		expected: unknown
		name?: string
		): void =>

	lItems := [...value]
	Deno.test name || getTestName(), () => assertEquals(lItems, expected)
	return

# ---------------------------------------------------------------------------
# ASYNC

export generatesAsync := <TOut>(
		value: TAsyncIterator<TOut>
		expected: unknown
		name?: string
		): void =>

	lItems := await Array.fromAsync value
	Deno.test name || getTestName(), () => assertEquals(lItems, expected)
	return

# ---------------------------------------------------------------------------

export unifies := (
		value: unknown
		expected: unknown
		name?: string
		): void =>

	Deno.test name || getTestName(), (): void =>
		unify value, expected
	return

# ---------------------------------------------------------------------------
# --- Create some values for testing
#     There should be at least one for each jsType

class MyClass
	fname: string
	lname: string
	constructor(@fname: string, @lname: string)
	fullname()
		return "#{@fname} #{@lname}"

export sampleVal: hash := {
	undef: undefined
	null: null
	emptyStr: ''
	str: 'abc'
	i: 42
	f: 3.14159
	inf: Infinity
	neginf: -Infinity
	NaN: Number.NaN
	b: true
	sym: Symbol('xxx')
	genFunc: () ->
		yield 42
		return
	asyncGenFunc: () ->
		await sleep(1)
		yield 42
		return
	regularFunc:    (): number -> return 42
	lambdaFunc:     (): number => return 42
	falsePredicate: () => return false
	truePredicate:  () => return true
	emptyHash: {}
	fullHash: {a: 42}
	emptyList: []
	fullList: [42]
	MyClass
	}


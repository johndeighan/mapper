# llutils.lib.civet

import {
	cyan, blue, black, red, green, magenta, yellow,
	stripAnsiCode,
	} from '@std/fmt/colors'

import {undef, defined} from 'base-utils'
import {assert} from 'croak'
import {
	hash, char, isString, isArray, isEmpty, nonEmpty,
	isArrayOfStrings,
	} from 'datatypes'

defWidth := 64     # ---used in sep, centered

# ---------------------------------------------------------------------------

export getOptions := <T extends hash>(
		hOptions: hash = {}
		hDefaults: T
		): T =>

	return { ...hDefaults, ...hOptions }

# ---------------------------------------------------------------------------

export words := (
		...lStrings: string[]
		): string[] =>

	lWords := []
	for str of lStrings
		for word of wsSplit(str)
			lWords.push word
	return lWords

# ---------------------------------------------------------------------------

wsSplit := (str: string): string[] =>

	newstr := str.trim()
	return (newstr == '') ? [] : newstr.split(/\s+/)

# ---------------------------------------------------------------------------

export rtrim := (line: string): string =>

	assert isString(line), "not a string: #{typeof line}"
	lMatches := line.match /^(.*?)\s+$/s
	return (lMatches == null) ? line : lMatches[1]

# ---------------------------------------------------------------------------

export type TAlignment = 'l' | 'c' | 'r' | 'left' | 'center' | 'right'

export isAlignment := (x: unknown): x is TAlignment =>
	return (
		   (typeof x == 'string')
		&& ['l', 'c', 'r', 'left', 'center', 'right'].includes(x)
		)

export alignString := function(
		str: string
		width: number
		align: TAlignment
		): string

	switch align
		case 'left':
		case 'l':
			return rpad str, width
		case 'center':
		case 'c':
			return sep ' ', str, width
		case 'right':
		case 'r':
			return lpad str, width

# ---------------------------------------------------------------------------

export rpad := (str: string, len: number, ch: string = ' '): string =>

	assert (ch.length == 1), "Not a char"
	extra := getNExtra str, len
	return str + ch.repeat(extra)

# ---------------------------------------------------------------------------

export lpad := (str: string, len: number, ch: string = ' '): string =>

	assert (ch.length == 1), "Not a char"
	extra := getNExtra str, len
	return ch.repeat(extra) + str

# ---------------------------------------------------------------------------

getNExtra := (str: string, len: number): number =>

	extra := len - str.length
	return if (extra > 0) then extra else 0

# ---------------------------------------------------------------------------

export sep := (
		char: string = '-',
		label: string? = undef,
		width: number = defWidth
		): string =>

	assert (char.length == 1), "Not a char: #{char}"
	if defined(label)
		return centered label, {char, width}
	else
		return char.repeat width

# ---------------------------------------------------------------------------
# --- valid options:
#        char - char to use on left and right
#        width - full width
#        numBuffer - num spaces around label when char <> ' '
#        color - color of entire string

export centered := (
		label: string
		hOptions: hash = {}
		): string =>

	type opt = {
		char: char
		width: number
		numBuffer: number
		color: string?
		}
	{char, width, numBuffer, color} := getOptions<opt> hOptions, {
		char: ' '
		width: defWidth
		numBuffer: 2
		color: undef
		}

	totSpaces := (width >= label.length) ? width - label.length : 0
	numLeft := Math.floor totSpaces / 2
	numRight := totSpaces - numLeft
	text := (
		if (char == ' ')
			' '.repeat(numLeft) + colorize(label, color) + ' '.repeat(numRight)
		else
			buf := ' '.repeat numBuffer
			left := char.repeat numLeft - numBuffer
			right := char.repeat numRight - numBuffer
			left + buf + colorize(label, color) + buf + right
		)
	return text

# ---------------------------------------------------------------------------
# --- hash of all supported colors

hColor := {
	cyan
	blue
	black
	red
	green
	magenta
	yellow
	} as const

# ---------------------------------------------------------------------------

export colorize := (
		str: string,
		color: string?
		): string =>

	if color && (color in hColor)
		switch color
			when 'cyan' then return cyan(str)
			when 'blue' then return blue(str)
			when 'black' then return black(str)
			when 'red' then return red(str)
			when 'green' then return green(str)
			when 'magenta' then return magenta(str)
			when 'yellow' then return yellow(str)
	return str

# ---------------------------------------------------------------------------

export type TBlockSpec = string | string[]
export isBlockSpec := (x: unknown): x is TBlockSpec =>
	return isString(x) || isArrayOfStrings(x)

# ---------------------------------------------------------------------------

export blockToArray := (block: string): string[] =>

	if isEmpty(block)
		return []
	else
		return block.split /\r?\n/

# ---------------------------------------------------------------------------

export toArray := (strOrArray: TBlockSpec): string[] =>

	if Array.isArray(strOrArray)
		return strOrArray
	else
		return blockToArray strOrArray

# ---------------------------------------------------------------------------

export arrayToBlock := (lLines: string[]): string =>

	assert isArray(lLines), "lLines is not an array: #{lLines}"
	return lLines.filter((line) => defined line).join "\n"

# ---------------------------------------------------------------------------

export toBlock := (strOrArray: TBlockSpec): string =>

	if isString(strOrArray)
		return strOrArray
	else
		return arrayToBlock strOrArray

# ---------------------------------------------------------------------------

export inRange := (
		n: number
		max: number
		): boolean =>

	return (n >= 0) && (n < max)

# ---------------------------------------------------------------------------

export max := (x: number, y: number): number =>

	return (x > y) ? x : y

# ---------------------------------------------------------------------------

export range := (n: number): Generator<number, void, void> ->

	for i of [0...n]
		yield i
	return

# ---------------------------------------------------------------------------

# croak.lib.test.civet

import {
	onlyThrow, justThrow, TAssertFunc, assert, obviously,
	TFrameType, TStackFrame, TFrameFilter,
	dumpFrame, allStackFrames, getErrStr,
	croak, TRY,
	} from 'croak'
import {
	equal, truthy, falsy, succeeds, fails,
	} from 'unit-test'

# ---------------------------------------------------------------------------

succeeds () => assert (2+2 == 4)
fails    () => assert (2+2 == 5)

succeeds () => obviously (2+2 == 4)
fails    () => obviously (2+2 == 5)

succeeds () => Array.from(allStackFrames())
fails    () => croak("Bad")

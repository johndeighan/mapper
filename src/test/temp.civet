# ---------------------------------------------------------------------------
# Using MAP()

generates
	MAP gen(), (n) ->
		yield 2*n
		return
	[2,6,10]

equal
	MAP gen(), 0, (n, acc) ->
		return acc + n
	9

(() =>
	iter := MAP [1,3,5], 0, (n, acc) ->
		yield 2*n
		return acc + n

	[lItems, acc] := arrayAndAccumFrom iter
	equal lItems, [2, 6, 10]
	equal acc, 9
	)()


await (() =>
	iter := await MAP agen(), (n) ->
		yield 2*n
		return

	result := await Array.fromAsync iter
	equal result, [2, 6, 10]
	)()


generates
	await MAP agen(), (n) ->
		yield 2*n
		return
	[2, 6, 10]

await (() =>
	acc := await MAP agen(), 0, (n, acc) ->
		return acc + n
	equal acc, 9
	)()

await (() =>
	outIter := MAP agen(), 0, (n, acc) ->
		yield 2*n
		return acc + n

	[lItems, acc] := await asyncArrayAndAccumFrom(outIter)
	equal lItems, [2, 6, 10]
	equal acc, 9
	)()
